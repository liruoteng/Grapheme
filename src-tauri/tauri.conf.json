{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapheme",
  "version": "0.1.0",
  "identifier": "com.ruoteng.grapheme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grapheme",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: asset:; connect-src 'self' https://api.semanticscholar.org ws://127.0.0.1:8765; worker-src 'self' blob:; media-src 'self' asset:; frame-src 'self' http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tinymist"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
